# --- App ---
ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (matches docker-compose service 'db') ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/notebook_rag
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/notebook_rag

# --- Redis / Celery (matches docker-compose service 'redis') ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Storage ---
UPLOAD_DIR=./storage/uploads

# --- LLM / Embeddings: fill this in (used for chat, rerank, embeddings, TTS) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Chunking ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# --- Retrieval ---
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_FINAL=6
USE_RERANKER=true

# --- Podcast TTS voices (OpenAI TTS voice names) ---
OPENAI_TTS_VOICE_HOST_A=alloy
OPENAI_TTS_VOICE_HOST_B=echo

# --- Auth (Clerk) ---
# Clerk Dashboard -> Configure -> API Keys -> "Frontend API URL"
# (looks like https://your-app-name-12.clerk.accounts.dev, or your
# custom Clerk domain in production). Required for verifying session
# tokens sent from the frontend -- requests fail auth without it.
CLERK_ISSUER=
